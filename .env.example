# Система знаний команды — пример конфигурации
# Скопируйте в .env и заполните значения.
# Основание: docs/Технический проект - Система знаний команды.pdf

# --- Persistence Layer (§7, §12.1) ---
# SQLite по умолчанию; для PostgreSQL укажите строку подключения SQLAlchemy
DATABASE_URL=sqlite:///./data/db/knowledge_base.db
# Пример строки подключения к PostgreSQL (опционально)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/knowledge_db

# --- OpenAI API (§6, §7) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ANSWERING_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=4096
# Опциональный OpenAI API эндпоинт
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Поиск и RAG (§13.1) ---
# Количество релевантных сниппетов из Chroma
TOP_K=5
# Порог косинусной схожести (0..1); ниже порога LLM не вызывается
SIMILARITY_THRESHOLD=0.4

# --- Chroma — векторное хранилище (§12.2) ---
CHROMA_COLLECTION=knowledge_base
# Локальный режим: если задано — используется persist-директория Chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
# Сетевой режим Chroma (альтернатива локальному persist)
CHROMA_HOST=
CHROMA_PORT=
CHROMA_SSL=false
# Облачный режим Chroma
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=default_database

# --- Frontend Service (§6, §16) ---
BACKEND_API_URL=http://localhost:8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
